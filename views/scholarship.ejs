<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Scholarships - AI Career Predictor</title>
   <link rel="stylesheet" href="/style.css">
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   <style>
      /* Additional styles for scholarship page */
      .scholarship-stats {
         display: grid;
         grid-template-columns: repeat(4, 1fr);
         gap: var(--spacing-4);
         margin: var(--spacing-6) 0;
      }

      .scholarship-stat-card {
         background: white;
         padding: var(--spacing-4);
         border-radius: var(--radius-xl);
         border: 1px solid var(--neutral-200);
         text-align: center;
         box-shadow: var(--shadow-sm);
      }

      .scholarship-stat-card .stat-number {
         font-size: var(--font-size-2xl);
         font-weight: 800;
         color: var(--primary-600);
         display: block;
      }

      .scholarship-stat-card .stat-label {
         font-size: var(--font-size-sm);
         color: var(--neutral-500);
      }

      .category-section {
         margin: var(--spacing-8) 0;
      }

      .category-title {
         display: flex;
         align-items: center;
         gap: var(--spacing-2);
         margin-bottom: var(--spacing-4);
         font-size: var(--font-size-2xl);
         color: var(--neutral-800);
      }

      .category-title i {
         color: var(--primary-500);
      }

      .category-title .count {
         font-size: var(--font-size-sm);
         color: var(--neutral-500);
         font-weight: 400;
      }

      .scholarship-grid {
         display: grid;
         grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
         gap: var(--spacing-6);
      }

      .scholarship-card {
         background: white;
         border-radius: var(--radius-2xl);
         border: 1px solid var(--neutral-200);
         overflow: hidden;
         transition: all var(--transition-base) ease;
         box-shadow: var(--shadow-sm);
      }

      .scholarship-card:hover {
         transform: translateY(-4px);
         box-shadow: var(--shadow-xl);
         border-color: var(--primary-200);
      }

      .scholarship-card .card-header {
         padding: var(--spacing-4) var(--spacing-6);
         background: var(--neutral-50);
         border-bottom: 1px solid var(--neutral-200);
         display: flex;
         justify-content: space-between;
         align-items: flex-start;
      }

      .scholarship-card .card-header .badge-container {
         display: flex;
         flex-direction: column;
         gap: var(--spacing-1);
         align-items: flex-end;
      }

      .scholarship-card .card-body {
         padding: var(--spacing-4) var(--spacing-6);
      }

      .scholarship-card .card-body h3 {
         font-size: var(--font-size-lg);
         margin-bottom: var(--spacing-1);
      }

      .scholarship-card .card-body .provider {
         font-size: var(--font-size-sm);
         color: var(--neutral-500);
         margin-bottom: var(--spacing-3);
      }

      .scholarship-card .card-body .provider i {
         color: var(--primary-400);
      }

      .benefits-list {
         display: flex;
         flex-wrap: wrap;
         gap: var(--spacing-1);
         margin: var(--spacing-3) 0;
      }

      .benefit-tag {
         background: var(--success-50);
         color: var(--success-700);
         padding: 2px 10px;
         border-radius: var(--radius-full);
         font-size: var(--font-size-xs);
         font-weight: 500;
      }

      .eligibility-grid {
         display: grid;
         grid-template-columns: 1fr 1fr;
         gap: var(--spacing-2);
         margin: var(--spacing-3) 0;
         padding: var(--spacing-3);
         background: var(--neutral-50);
         border-radius: var(--radius-lg);
      }

      .eligibility-item {
         display: flex;
         align-items: center;
         gap: var(--spacing-2);
         font-size: var(--font-size-sm);
         color: var(--neutral-600);
      }

      .eligibility-item i {
         color: var(--primary-500);
         width: 16px;
      }

      .requirements-list {
         margin: var(--spacing-3) 0;
         padding-left: var(--spacing-4);
      }

      .requirements-list li {
         font-size: var(--font-size-sm);
         color: var(--neutral-600);
         margin-bottom: var(--spacing-1);
         list-style-type: none;
      }

      .requirements-list li::before {
         content: '• ';
         color: var(--primary-500);
         font-weight: 700;
      }

      .scholarship-card .card-footer {
         padding: var(--spacing-4) var(--spacing-6);
         background: var(--neutral-50);
         border-top: 1px solid var(--neutral-200);
         display: flex;
         justify-content: space-between;
         align-items: center;
         flex-wrap: wrap;
         gap: var(--spacing-2);
      }

      .scholarship-card .card-footer .deadline {
         font-size: var(--font-size-sm);
         color: var(--neutral-600);
      }

      .scholarship-card .card-footer .deadline i {
         color: var(--error-500);
      }

      .scholarship-card .card-footer .action-buttons {
         display: flex;
         gap: var(--spacing-2);
      }

      .match-score-display {
         display: flex;
         align-items: center;
         gap: var(--spacing-3);
      }

      .match-score-display .score-circle {
         width: 50px;
         height: 50px;
         border-radius: 50%;
         display: flex;
         align-items: center;
         justify-content: center;
         font-weight: 700;
         font-size: var(--font-size-base);
         color: white;
      }

      .match-score-display .score-circle.excellent {
         background: var(--success-500);
      }

      .match-score-display .score-circle.good {
         background: var(--primary-500);
      }

      .match-score-display .score-circle.moderate {
         background: var(--warning-500);
      }

      .match-score-display .score-circle.needs-improvement {
         background: var(--error-500);
      }

      .match-details {
         display: grid;
         grid-template-columns: 1fr 1fr;
         gap: var(--spacing-2);
         margin: var(--spacing-3) 0;
         font-size: var(--font-size-sm);
      }

      .match-details .detail-item {
         display: flex;
         justify-content: space-between;
         padding: var(--spacing-1) 0;
         border-bottom: 1px solid var(--neutral-100);
      }

      .match-details .detail-item .label {
         color: var(--neutral-500);
      }

      .match-details .detail-item .value {
         font-weight: 600;
         color: var(--neutral-800);
      }

      .scholarship-actions {
         margin-top: var(--spacing-8);
         text-align: center;
      }

      .no-scholarships {
         text-align: center;
         padding: var(--spacing-12);
         background: white;
         border-radius: var(--radius-2xl);
         border: 2px dashed var(--neutral-200);
      }

      .no-scholarships i {
         font-size: var(--font-size-5xl);
         color: var(--neutral-300);
         margin-bottom: var(--spacing-4);
      }

      @media (max-width: 768px) {
         .scholarship-stats {
            grid-template-columns: repeat(2, 1fr);
         }

         .scholarship-grid {
            grid-template-columns: 1fr;
         }

         .eligibility-grid {
            grid-template-columns: 1fr;
         }

         .match-details {
            grid-template-columns: 1fr;
         }

         .scholarship-card .card-footer {
            flex-direction: column;
            text-align: center;
         }

         .scholarship-card .card-header {
            flex-direction: column;
            gap: var(--spacing-2);
         }

         .scholarship-card .card-header .badge-container {
            align-items: flex-start;
            flex-direction: row;
            flex-wrap: wrap;
         }
      }

      @media (max-width: 480px) {
         .scholarship-stats {
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-2);
         }

         .scholarship-stat-card {
            padding: var(--spacing-3);
         }

         .scholarship-stat-card .stat-number {
            font-size: var(--font-size-xl);
         }

         .scholarship-card .card-body {
            padding: var(--spacing-3);
         }

         .scholarship-card .card-header {
            padding: var(--spacing-3);
         }

         .scholarship-card .card-footer {
            padding: var(--spacing-3);
         }
      }
   </style>
</head>

<body>
   <nav class="navbar">
      <div class="nav-container">
         <div class="logo">
            <a href="/">
               <i class="fas fa-robot"></i>
               <span>AI Career<span class="highlight">Predictor</span></span>
            </a>
         </div>
         <button class="nav-toggle">
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
         </button>
         <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/assessment">Assessment</a></li>
            <li><a href="/results">Results</a></li>
            <li><a href="/scholarship" class="active">Scholarships</a></li>
            <li><a href="/skills">Skills</a></li>
         </ul>
      </div>
   </nav>

   <main>
      <!-- Hero Section -->
      <section class="scholarship-hero">
         <div class="container">
            <div class="scholarship-header">
               <h1><i class="fas fa-dollar-sign"></i> Scholarship Recommendations</h1>
               <p>Personalized scholarships based on your academic profile, interests, and career goals</p>
            </div>
         </div>
      </section>

      <!-- Statistics -->
      <section class="scholarship-stats-section">
         <div class="container">
            <div class="scholarship-stats">
               <div class="scholarship-stat-card">
                  <span class="stat-number">
                     <%= scholarships.length %>
                  </span>
                  <span class="stat-label">Total Scholarships</span>
               </div>
               <div class="scholarship-stat-card">
                  <span class="stat-number">
                     <%= scholarships.filter(s=> s.matchScore >= 70).length %>
                  </span>
                  <span class="stat-label">High Match (70%+)</span>
               </div>
               <div class="scholarship-stat-card">
                  <span class="stat-number">
                     <%= scholarships.filter(s=> s.confidence >= 70).length %>
                  </span>
                  <span class="stat-label">High Confidence</span>
               </div>
               <div class="scholarship-stat-card">
                  <span class="stat-number">
                     <%= Object.keys(categories).length %>
                  </span>
                  <span class="stat-label">Categories</span>
               </div>
            </div>
         </div>
      </section>

      <!-- Scholarship Categories -->
      <section class="scholarship-categories">
         <div class="container">
            <% Object.keys(categories).forEach(category=> { %>
               <div class="category-section">
                  <h2 class="category-title">
                     <i class="fas fa-tag"></i>
                     <%= category %>
                        <span class="count">(<%= categories[category].length %>)</span>
                  </h2>

                  <div class="scholarship-grid">
                     <% categories[category].forEach(scholarship=> { %>
                        <div class="scholarship-card">
                           <div class="card-header">
                              <div>
                                 <span class="provider"><i class="fas fa-building"></i>
                                    <%= scholarship.provider || 'Various' %>
                                 </span>
                                 <br>
                                 <span style="font-size: var(--font-size-xs); color: var(--neutral-400);">
                                    <%= scholarship.type || 'Scholarship' %>
                                 </span>
                              </div>
                              <div class="badge-container">
                                 <span class="match-badge <%= scholarship.matchLevel.toLowerCase() %>">
                                    <%= scholarship.matchScore %>% Match
                                 </span>
                                 <span style="font-size: var(--font-size-xs); color: var(--neutral-500);">
                                    <i class="fas fa-check-circle" style="color: var(--success-500);"></i>
                                    <%= scholarship.confidence %>% Confidence
                                 </span>
                              </div>
                           </div>

                           <div class="card-body">
                              <h3>
                                 <%= scholarship.name %>
                              </h3>
                              <p class="provider"><i class="fas fa-info-circle"></i>
                                 <%= scholarship.description || 'Scholarship opportunity for eligible students.' %>
                              </p>

                              <div class="match-score-display">
                                 <div class="score-circle <%= scholarship.matchLevel.toLowerCase() %>">
                                    <%= scholarship.matchScore %>%
                                 </div>
                                 <div style="flex: 1;">
                                    <div
                                       style="font-size: var(--font-size-sm); font-weight: 600; color: var(--neutral-800);">
                                       <%= scholarship.amount || 'Amount varies' %>
                                    </div>
                                    <div style="font-size: var(--font-size-xs); color: var(--neutral-500);">
                                       <%= scholarship.benefits || 'Benefits included' %>
                                    </div>
                                 </div>
                              </div>

                              <div class="match-details">
                                 <div class="detail-item">
                                    <span class="label">Academic Match</span>
                                    <span class="value">
                                       <%= scholarship.matchDetails.academicMatch %>%
                                    </span>
                                 </div>
                                 <div class="detail-item">
                                    <span class="label">Interest Match</span>
                                    <span class="value">
                                       <%= scholarship.matchDetails.interestMatch %>%
                                    </span>
                                 </div>
                                 <div class="detail-item">
                                    <span class="label">Career Match</span>
                                    <span class="value">
                                       <%= scholarship.matchDetails.careerMatch %>%
                                    </span>
                                 </div>
                                 <div class="detail-item">
                                    <span class="label">GPA Match</span>
                                    <span class="value">
                                       <%= scholarship.matchDetails.gpaMatch %>%
                                    </span>
                                 </div>
                              </div>

                              <div class="eligibility-grid">
                                 <div class="eligibility-item">
                                    <i class="fas fa-graduation-cap"></i>
                                    <span>GPA: <%= scholarship.eligibility.gpa || '3.0' %>+</span>
                                 </div>
                                 <div class="eligibility-item">
                                    <i class="fas fa-users"></i>
                                    <span>
                                       <%= scholarship.eligibility.nationality || 'International' %>
                                    </span>
                                 </div>
                                 <div class="eligibility-item">
                                    <i class="fas fa-book"></i>
                                    <span>
                                       <%= (scholarship.eligibility.fields || ['All']).join(', ') %></span>
                                    </div>
                                    <div class="eligibility-item">
                                        <i class="fas fa-level-up-alt"></i>
                                        <span><%= (scholarship.eligibility.level || [' Undergraduate']).join(', ') %></span>
                                    </div>
                                </div>
                                
                                <div style="margin-top: var(--spacing-3);">
                                    <strong style="font-size: var(--font-size-sm); color: var(--neutral-700);">Benefits:</strong>
                                    <div class="benefits-list">
                                        <% (scholarship.benefits || ' Various benefits').split(', ').forEach(benefit => { %>
                                        <span class="benefit-tag"><%= benefit %></span>
                                        <% }) %>
                                    </div>
                                </div>
                                
                                <div style="margin-top: var(--spacing-3);">
                                    <strong style="font-size: var(--font-size-sm); color: var(--neutral-700);">Requirements:</strong>
                                    <ul class="requirements-list">
                                        <% (scholarship.applicationRequirements || ['Application form', 'Academic transcripts', 'Recommendation letters']).forEach(req=> { %>
                                          <li>
                                             <%= req %>
                                          </li>
                                          <% }) %>
                                             </ul>
                                 </div>
                              </div>

                              <div class="card-footer">
                                 <div class="deadline">
                                    <i class="fas fa-calendar-alt"></i>
                                    Deadline: <%= new Date(scholarship.deadline).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                 </div>
                                 <div class="action-buttons">
                                    <a href="<%= scholarship.website || '#' %>" class="btn btn-primary btn-sm"
                                       target="_blank">
                                       <i class="fas fa-external-link-alt"></i> Apply Now
                                    </a>
                                    <button class="btn btn-secondary btn-sm"
                                       onclick="saveScholarship('<%= scholarship.id %>')">
                                       <i class="fas fa-bookmark"></i> Save
                                    </button>
                                 </div>
                              </div>
                           </div>
                           <% }) %>
                        </div>
                  </div>
                  <% }) %>

                     <% if (Object.keys(categories).length===0) { %>
                        <div class="no-scholarships">
                           <i class="fas fa-search"></i>
                           <h3>No Scholarships Found</h3>
                           <p>Complete your assessment to get personalized scholarship recommendations.</p>
                           <a href="/assessment" class="btn btn-primary">Take Assessment</a>
                        </div>
                        <% } %>
               </div>
      </section>

      <!-- Next Steps -->
      <section class="scholarship-actions">
         <div class="container">
            <div class="cta-box">
               <h3>Ready to Apply?</h3>
               <p>Start your scholarship applications early and increase your chances of success</p>
               <div class="cta-buttons">
                  <a href="/results" class="btn btn-secondary"><i class="fas fa-chart-bar"></i> View Career Results</a>
                  <a href="/skills" class="btn btn-secondary"><i class="fas fa-lightbulb"></i> View Skills</a>
                  <a href="/assessment" class="btn btn-secondary"><i class="fas fa-edit"></i> Retake Assessment</a>
               </div>
            </div>
         </div>
      </section>
   </main>

   <footer class="footer">
      <div class="footer-container">
         <div class="footer-grid">
            <div class="footer-brand">
               <div class="logo">
                  <i class="fas fa-robot"></i>
                  <span>AI Career<span class="highlight">Predictor</span></span>
               </div>
               <p>Empowering students to make informed career decisions through AI-powered insights.</p>
               <div class="social-links">
                  <a href="#"><i class="fab fa-twitter"></i></a>
                  <a href="#"><i class="fab fa-linkedin-in"></i></a>
                  <a href="#"><i class="fab fa-facebook-f"></i></a>
                  <a href="#"><i class="fab fa-youtube"></i></a>
               </div>
            </div>
            <div class="footer-links">
               <h4>Platform</h4>
               <ul>
                  <li><a href="/assessment">Assessment</a></li>
                  <li><a href="/results">Results</a></li>
                  <li><a href="/scholarship">Scholarships</a></li>
                  <li><a href="/skills">Skills</a></li>
               </ul>
            </div>
            <div class="footer-links">
               <h4>Resources</h4>
               <ul>
                  <li><a href="#">Career Guide</a></li>
                  <li><a href="#">Success Stories</a></li>
                  <li><a href="#">FAQ</a></li>
                  <li><a href="#">Blog</a></li>
               </ul>
            </div>
            <div class="footer-links">
               <h4>Company</h4>
               <ul>
                  <li><a href="#">About Us</a></li>
                  <li><a href="#">Contact</a></li>
                  <li><a href="#">Privacy Policy</a></li>
                  <li><a href="#">Terms of Service</a></li>
               </ul>
            </div>
         </div>
         <div class="footer-bottom">
            <p>&copy; 2026 AI Career Predictor. All rights reserved.</p>
            <p class="footer-tech">Powered by <i class="fas fa-microchip"></i> AI Technology</p>
         </div>
      </div>
   </footer>

   <script>
      // Save scholarship function
      function saveScholarship(id) {
         const button = event.target.closest('button');
         const icon = button.querySelector('i');
         const text = button.textContent.trim();

         if (icon.classList.contains('fa-bookmark')) {
            icon.className = 'fas fa-check';
            button.innerHTML = '<i class="fas fa-check"></i> Saved';
            button.style.background = 'var(--success-50)';
            button.style.color = 'var(--success-700)';
            showNotification('Scholarship saved successfully!', 'success');
         } else {
            icon.className = 'fas fa-bookmark';
            button.innerHTML = '<i class="fas fa-bookmark"></i> Save';
            button.style.background = '';
            button.style.color = '';
            showNotification('Scholarship removed from saved', 'info');
         }
      }

      // Animate stats on load
      document.addEventListener('DOMContentLoaded', function () {
         document.querySelectorAll('.stat-number').forEach(stat => {
            const target = parseInt(stat.textContent);
            let current = 0;
            const duration = 1000;
            const steps = 20;
            const increment = target / steps;

            const update = () => {
               current += increment;
               if (current >= target) {
                  stat.textContent = target;
                  return;
               }
               stat.textContent = Math.round(current);
               requestAnimationFrame(update);
            };

            update();
         });
      });
   </script>
   <script src="/script.js"></script>
</body>

</html>