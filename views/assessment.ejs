                        (Strongly Agree)</p>

                     <% var personalityQuestions=[ {id: 1,
                        text: "I enjoy working in teams and collaborating with others." }, {id: 2,
                        text: "I prefer to work independently rather than in groups." }, {id: 3,
                        text: "I am naturally curious and love learning new things." }, {id: 4,
                        text: "I am a creative person who enjoys thinking outside the box." }, {id: 5,
                        text: "I am organized and pay attention to details." }, {id: 6,
                        text: "I am comfortable taking risks and trying new approaches." }, {id: 7,
                        text: "I am good at understanding and empathizing with others." }, {id: 8,
                        text: "I am competitive and strive to be the best." }, {id: 9,
                        text: "I enjoy solving complex problems and puzzles." }, {id: 10,
                        text: "I am adaptable and handle change well." }, {id: 11,
                        text: "I am a natural leader who inspires others." }, {id: 12,
                        text: "I am patient and persistent in achieving my goals." }, {id: 13,
                        text: "I enjoy public speaking and presenting ideas." }, {id: 14,
                        text: "I am analytical and think logically about problems." }, {id: 15,
                        text: "I am passionate about making a positive impact on society." } ]; for (var i=0; i <
