<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Career Assessment - AI Career Predictor</title>
   <link rel="stylesheet" href="/style.css">
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
   <!-- Navigation -->
   <nav class="navbar" role="navigation" aria-label="Main navigation">
      <div class="nav-container">
         <div class="logo">
            <a href="/">
               <i class="fas fa-robot" aria-hidden="true"></i>
               <span>AI Career<span class="highlight">Predictor</span></span>
            </a>
         </div>
         <button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
         </button>
         <ul class="nav-links" role="menubar">
            <li role="none"><a href="/" role="menuitem">Home</a></li>
            <li role="none"><a href="/assessment" role="menuitem" class="active">Assessment</a></li>
            <li role="none"><a href="/results" role="menuitem">Results</a></li>
            <li role="none"><a href="/scholarship" role="menuitem">Scholarships</a></li>
            <li role="none"><a href="/skills" role="menuitem">Skills</a></li>
         </ul>
      </div>
   </nav>

   <main>
      <!-- Assessment Hero -->
      <section class="assessment-hero">
         <div class="container">
            <div class="assessment-header">
               <h1><i class="fas fa-clipboard-list"></i> Career Assessment</h1>
               <p>Complete all 7 steps to receive personalized career recommendations</p>
            </div>
         </div>
      </section>

      <!-- Assessment Form -->
      <section class="assessment-form">
         <div class="container">
            <form id="assessmentForm" action="/assessment" method="POST" class="form-container" novalidate>
               <!-- Hidden step field -->
               <input type="hidden" name="step" id="currentStep" value="1">

               <!-- Progress Bar -->
               <div class="form-progress">
                  <div class="progress-bar">
                     <div class="progress-fill" id="progressFill" style="width: 14.28%;"></div>
                  </div>
                  <div class="progress-steps">
                     <span class="step-indicator active" data-step="1">1</span>
                     <span class="step-indicator" data-step="2">2</span>
                     <span class="step-indicator" data-step="3">3</span>
                     <span class="step-indicator" data-step="4">4</span>
                     <span class="step-indicator" data-step="5">5</span>
                     <span class="step-indicator" data-step="6">6</span>
                     <span class="step-indicator" data-step="7">7</span>
                  </div>
               </div>

               <!-- ======================================== -->
               <!-- STEP 1: Student Information -->
               <!-- ======================================== -->
               <div class="form-step active" data-step="1">
                  <h2><i class="fas fa-user-graduate"></i> Student Information</h2>
                  <p class="step-description">Tell us about yourself so we can personalize your recommendations.</p>

                  <div class="form-grid">
                     <div class="form-group">
                        <label for="studentName">Full Name <span class="required">*</span></label>
                        <input type="text" id="studentName" name="studentName" placeholder="Enter your full name"
                           value="<%= typeof formData !== 'undefined' && formData.studentName ? formData.studentName : '' %>"
                           required>
                     </div>

                     <div class="form-group">
                        <label for="studentAge">Age <span class="required">*</span></label>
                        <input type="number" id="studentAge" name="studentAge" placeholder="Enter your age" min="14"
                           max="25"
                           value="<%= typeof formData !== 'undefined' && formData.studentAge ? formData.studentAge : '' %>"
                           required>
                     </div>

                     <div class="form-group">
                        <label for="gender">Gender <span class="required">*</span></label>
                        <select id="gender" name="gender" required>
                           <option value="">Select gender</option>
                           <option value="male" <%=typeof formData !=='undefined' && formData.gender==='male'
                              ? 'selected' : '' %>>Male</option>
                           <option value="female" <%=typeof formData !=='undefined' && formData.gender==='female'
                              ? 'selected' : '' %>>Female</option>
                           <option value="non-binary" <%=typeof formData !=='undefined' &&
                              formData.gender==='non-binary' ? 'selected' : '' %>>Non-binary</option>
                           <option value="prefer-not" <%=typeof formData !=='undefined' &&
                              formData.gender==='prefer-not' ? 'selected' : '' %>>Prefer not to say</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="schoolLevel">Current School Level <span class="required">*</span></label>
                        <select id="schoolLevel" name="schoolLevel" required>
                           <option value="">Select school level</option>
                           <option value="ss1" <%=typeof formData !=='undefined' && formData.schoolLevel==='ss1'
                              ? 'selected' : '' %>>SS1</option>
                           <option value="ss2" <%=typeof formData !=='undefined' && formData.schoolLevel==='ss2'
                              ? 'selected' : '' %>>SS2</option>
                           <option value="ss3" <%=typeof formData !=='undefined' && formData.schoolLevel==='ss3'
                              ? 'selected' : '' %>>SS3</option>
                           <option value="undergraduate" <%=typeof formData !=='undefined' &&
                              formData.schoolLevel==='undergraduate' ? 'selected' : '' %>>Undergraduate</option>
                           <option value="postgraduate" <%=typeof formData !=='undefined' &&
                              formData.schoolLevel==='postgraduate' ? 'selected' : '' %>>Postgraduate</option>
                           <option value="graduate" <%=typeof formData !=='undefined' &&
                              formData.schoolLevel==='graduate' ? 'selected' : '' %>>Graduate</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="stateOfOrigin">State of Origin <span class="required">*</span></label>
                        <select id="stateOfOrigin" name="stateOfOrigin" required>
                           <option value="">Select your state</option>
                           <option value="abia" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='abia'
                              ? 'selected' : '' %>>Abia</option>
                           <option value="adamawa" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='adamawa' ? 'selected' : '' %>>Adamawa</option>
                           <option value="akwa-ibom" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='akwa-ibom' ? 'selected' : '' %>>Akwa Ibom</option>
                           <option value="anambra" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='anambra' ? 'selected' : '' %>>Anambra</option>
                           <option value="bauchi" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='bauchi'
                              ? 'selected' : '' %>>Bauchi</option>
                           <option value="bayelsa" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='bayelsa' ? 'selected' : '' %>>Bayelsa</option>
                           <option value="benue" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='benue'
                              ? 'selected' : '' %>>Benue</option>
                           <option value="borno" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='borno'
                              ? 'selected' : '' %>>Borno</option>
                           <option value="cross-river" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='cross-river' ? 'selected' : '' %>>Cross River</option>
                           <option value="delta" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='delta'
                              ? 'selected' : '' %>>Delta</option>
                           <option value="ebonyi" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='ebonyi'
                              ? 'selected' : '' %>>Ebonyi</option>
                           <option value="edo" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='edo'
                              ? 'selected' : '' %>>Edo</option>
                           <option value="ekiti" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='ekiti'
                              ? 'selected' : '' %>>Ekiti</option>
                           <option value="enugu" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='enugu'
                              ? 'selected' : '' %>>Enugu</option>
                           <option value="fct" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='fct'
                              ? 'selected' : '' %>>FCT Abuja</option>
                           <option value="gombe" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='gombe'
                              ? 'selected' : '' %>>Gombe</option>
                           <option value="imo" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='imo'
                              ? 'selected' : '' %>>Imo</option>
                           <option value="jigawa" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='jigawa'
                              ? 'selected' : '' %>>Jigawa</option>
                           <option value="kaduna" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='kaduna'
                              ? 'selected' : '' %>>Kaduna</option>
                           <option value="kano" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='kano'
                              ? 'selected' : '' %>>Kano</option>
                           <option value="katsina" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='katsina' ? 'selected' : '' %>>Katsina</option>
                           <option value="kebbi" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='kebbi'
                              ? 'selected' : '' %>>Kebbi</option>
                           <option value="kogi" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='kogi'
                              ? 'selected' : '' %>>Kogi</option>
                           <option value="kwara" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='kwara'
                              ? 'selected' : '' %>>Kwara</option>
                           <option value="lagos" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='lagos'
                              ? 'selected' : '' %>>Lagos</option>
                           <option value="nasarawa" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='nasarawa' ? 'selected' : '' %>>Nasarawa</option>
                           <option value="niger" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='niger'
                              ? 'selected' : '' %>>Niger</option>
                           <option value="ogun" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='ogun'
                              ? 'selected' : '' %>>Ogun</option>
                           <option value="ondo" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='ondo'
                              ? 'selected' : '' %>>Ondo</option>
                           <option value="osun" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='osun'
                              ? 'selected' : '' %>>Osun</option>
                           <option value="oyo" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='oyo'
                              ? 'selected' : '' %>>Oyo</option>
                           <option value="plateau" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='plateau' ? 'selected' : '' %>>Plateau</option>
                           <option value="rivers" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='rivers'
                              ? 'selected' : '' %>>Rivers</option>
                           <option value="sokoto" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='sokoto'
                              ? 'selected' : '' %>>Sokoto</option>
                           <option value="taraba" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='taraba'
                              ? 'selected' : '' %>>Taraba</option>
                           <option value="yobe" <%=typeof formData !=='undefined' && formData.stateOfOrigin==='yobe'
                              ? 'selected' : '' %>>Yobe</option>
                           <option value="zamfara" <%=typeof formData !=='undefined' &&
                              formData.stateOfOrigin==='zamfara' ? 'selected' : '' %>>Zamfara</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="nationality">Nationality <span class="required">*</span></label>
                        <select id="nationality" name="nationality" required>
                           <option value="">Select nationality</option>
                           <option value="nigerian" <%=typeof formData !=='undefined' &&
                              formData.nationality==='nigerian' ? 'selected' : '' %>>Nigerian</option>
                           <option value="other" <%=typeof formData !=='undefined' && formData.nationality==='other'
                              ? 'selected' : '' %>>Other</option>
                        </select>
                     </div>
                  </div>

                  <div class="form-navigation">
                     <button type="button" class="btn btn-primary" onclick="nextStep()">
                        Next Step <i class="fas fa-arrow-right"></i>
                     </button>
                  </div>
               </div>

               <!-- ======================================== -->
               <!-- STEP 2: Academic Performance -->
               <!-- ======================================== -->
               <div class="form-step" data-step="2">
                  <h2><i class="fas fa-chart-line"></i> Academic Performance</h2>
                  <p class="step-description">Share your WAEC/NECO grades (A1-F9) to help us understand your academic
                     strengths.</p>

                  <div class="form-grid">
                     <div class="form-group">
                        <label for="mathGrade">Mathematics <span class="required">*</span></label>
                        <select id="mathGrade" name="mathGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.mathGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.mathGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.mathGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.mathGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.mathGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.mathGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.mathGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.mathGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.mathGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="englishGrade">English Language <span class="required">*</span></label>
                        <select id="englishGrade" name="englishGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.englishGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.englishGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.englishGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.englishGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.englishGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.englishGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.englishGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.englishGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.englishGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="biologyGrade">Biology <span class="required">*</span></label>
                        <select id="biologyGrade" name="biologyGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.biologyGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.biologyGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.biologyGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.biologyGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.biologyGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.biologyGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.biologyGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.biologyGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.biologyGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="chemistryGrade">Chemistry <span class="required">*</span></label>
                        <select id="chemistryGrade" name="chemistryGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.chemistryGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.chemistryGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.chemistryGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.chemistryGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.chemistryGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.chemistryGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.chemistryGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.chemistryGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.chemistryGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="physicsGrade">Physics <span class="required">*</span></label>
                        <select id="physicsGrade" name="physicsGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.physicsGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.physicsGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.physicsGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.physicsGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.physicsGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.physicsGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.physicsGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.physicsGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.physicsGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="governmentGrade">Government <span class="required">*</span></label>
                        <select id="governmentGrade" name="governmentGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.governmentGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.governmentGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.governmentGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.governmentGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.governmentGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.governmentGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.governmentGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.governmentGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.governmentGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group">
                        <label for="literatureGrade">Literature in English <span class="required">*</span></label>
                        <select id="literatureGrade" name="literatureGrade" required>
                           <option value="">Select grade</option>
                           <option value="95" <%=typeof formData !=='undefined' && formData.literatureGrade==='95'
                              ? 'selected' : '' %>>A1 (95%)</option>
                           <option value="85" <%=typeof formData !=='undefined' && formData.literatureGrade==='85'
                              ? 'selected' : '' %>>B2 (85%)</option>
                           <option value="78" <%=typeof formData !=='undefined' && formData.literatureGrade==='78'
                              ? 'selected' : '' %>>B3 (78%)</option>
                           <option value="70" <%=typeof formData !=='undefined' && formData.literatureGrade==='70'
                              ? 'selected' : '' %>>C4 (70%)</option>
                           <option value="65" <%=typeof formData !=='undefined' && formData.literatureGrade==='65'
                              ? 'selected' : '' %>>C5 (65%)</option>
                           <option value="60" <%=typeof formData !=='undefined' && formData.literatureGrade==='60'
                              ? 'selected' : '' %>>C6 (60%)</option>
                           <option value="55" <%=typeof formData !=='undefined' && formData.literatureGrade==='55'
                              ? 'selected' : '' %>>D7 (55%)</option>
                           <option value="50" <%=typeof formData !=='undefined' && formData.literatureGrade==='50'
                              ? 'selected' : '' %>>E8 (50%)</option>
                           <option value="40" <%=typeof formData !=='undefined' && formData.literatureGrade==='40'
                              ? 'selected' : '' %>>F9 (40%)</option>
                        </select>
                     </div>

                     <div class="form-group" style="grid-column: 1 / -1;">
                        <label for="overallWAEC">Overall WAEC/NECO Score <span class="required">*</span></label>
                        <input type="number" id="overallWAEC" name="overallWAEC"
                           placeholder="Enter your overall score (0-100)" min="0" max="100"
                           value="<%= typeof formData !== 'undefined' && formData.overallWAEC ? formData.overallWAEC : '' %>"
                           required>
                     </div>
                  </div>

                  <div class="form-navigation">
                     <button type="button" class="btn btn-secondary" onclick="prevStep()">
                        <i class="fas fa-arrow-left"></i> Previous
                     </button>
                     <button type="button" class="btn btn-primary" onclick="nextStep()">
                        Next Step <i class="fas fa-arrow-right"></i>
                     </button>
                  </div>
               </div>

               <!-- ======================================== -->
               <!-- STEP 3: Favorite Subjects -->
