<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>AI Career Predictor - Discover Your Future</title>
   <link rel="stylesheet" href="/style.css">
   <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
   <!-- Navigation -->
   <nav class="navbar" role="navigation" aria-label="Main navigation">
      <div class="nav-container">
         <div class="logo">
            <a href="/">
               <i class="fas fa-robot" aria-hidden="true"></i>
               <span>AI Career<span class="highlight">Predictor</span></span>
            </a>
         </div>

         <button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
            <span class="hamburger"></span>
            <span class="hamburger"></span>
            <span class="hamburger"></span>
         </button>

         <ul class="nav-links" role="menubar">
            <li role="none"><a href="/" role="menuitem" class="active">Home</a></li>
            <li role="none"><a href="/assessment" role="menuitem">Assessment</a></li>
            <li role="none"><a href="/results" role="menuitem">Results</a></li>
            <li role="none"><a href="/scholarship" role="menuitem">Scholarships</a></li>
            <li role="none"><a href="/skills" role="menuitem">Skills</a></li>
            <li role="none"><a href="/pricing" role="menuitem" class="nav-premium-link">Pricing</a></li>
            <%- include('partials/auth-nav') %>
         </ul>
      </div>
   </nav>

   <!-- Hero Section -->
   <section class="hero" aria-label="Hero section">
      <div class="hero-container">
         <div class="hero-content">
            <div class="hero-badge">
               <span class="badge-pulse"></span>
               AI-Powered Career Guidance
            </div>
            <h1 class="hero-title">
               Discover Your <span class="gradient-text">Dream Career</span><br>
               With AI Intelligence
            </h1>
            <p class="hero-subtitle">
               Analyze your academic records, interests, and skills to receive personalized
               career recommendations, course suggestions, and scholarship opportunities.
            </p>
            <div class="hero-actions">
               <a href="<%= typeof user !== 'undefined' && user ? '/assessment' : '/signup' %>" class="btn btn-primary btn-large">
                  <i class="fas fa-rocket"></i> <%= typeof user !== 'undefined' && user ? 'Start Assessment' : 'Get Started Free' %>
               </a>
               <a href="#features" class="btn btn-secondary btn-large">
                  <i class="fas fa-play-circle"></i> Learn More
               </a>
            </div>
            <div class="hero-stats">
               <div class="stat-item">
                  <span class="stat-number" data-target="10000">0</span>
                  <span class="stat-label">Students Guided</span>
               </div>
               <div class="stat-item">
                  <span class="stat-number" data-target="95">0</span>
                  <span class="stat-label">Success Rate</span>
               </div>
               <div class="stat-item">
                  <span class="stat-number" data-target="500">0</span>
                  <span class="stat-label">Partner Universities</span>
               </div>
            </div>
         </div>
         <div class="hero-visual">
            <div class="hero-illustration">
               <div class="floating-icon icon-1"><i class="fas fa-graduation-cap"></i></div>
               <div class="floating-icon icon-2"><i class="fas fa-brain"></i></div>
               <div class="floating-icon icon-3"><i class="fas fa-chart-line"></i></div>
               <div class="floating-icon icon-4"><i class="fas fa-lightbulb"></i></div>
               <div class="floating-icon icon-5"><i class="fas fa-users"></i></div>
               <div class="hero-image-placeholder">
                  <i class="fas fa-robot fa-8x"></i>
               </div>
            </div>
         </div>
      </div>
   </section>

   <!-- Features Section -->
   <section class="features" id="features" aria-label="Features section">
      <div class="container">
         <div class="section-header">
            <span class="section-badge">Features</span>
            <h2>How AI Helps You Succeed</h2>
            <p>Our intelligent system analyzes multiple dimensions to provide comprehensive career guidance</p>
         </div>
         <div class="features-grid">
            <div class="feature-card">
               <div class="feature-icon">
                  <i class="fas fa-university"></i>
               </div>
               <h3>Course Recommendations</h3>
               <p>Get personalized university and course suggestions based on your academic profile, interests, and
                  career goals.</p>
               <div class="feature-tag">AI-Powered</div>
            </div>
            <div class="feature-card">
               <div class="feature-icon">
                  <i class="fas fa-briefcase"></i>
               </div>
               <h3>Career Predictions</h3>
               <p>Discover careers that align with your skills, personality traits, and interests with high accuracy.
               </p>
               <div class="feature-tag">95% Accuracy</div>
            </div>
            <div class="feature-card">
               <div class="feature-icon">
                  <i class="fas fa-dollar-sign"></i>
               </div>
               <h3>Scholarship Finder</h3>
               <p>Identify scholarship opportunities you're eligible for based on your academic performance and
                  achievements.</p>
               <div class="feature-tag">$50M+ Available</div>
            </div>
            <div class="feature-card">
               <div class="feature-icon">
                  <i class="fas fa-lightbulb"></i>
               </div>
               <h3>Skill Development</h3>
               <p>Get personalized skill recommendations to build competencies for your desired career path.</p>
               <div class="feature-tag">Personalized</div>
            </div>
         </div>
      </div>
   </section>

   <!-- How It Works Section -->
   <section class="how-it-works" aria-label="How it works section">
      <div class="container">
         <div class="section-header">
            <span class="section-badge">Process</span>
            <h2>How It Works</h2>
            <p>Four simple steps to discover your ideal career path</p>
         </div>
         <div class="steps-container">
            <div class="step">
               <div class="step-number">01</div>
               <div class="step-content">
                  <div class="step-icon">
                     <i class="fas fa-clipboard-list"></i>
                  </div>
                  <h3>Complete Assessment</h3>
                  <p>Fill in your academic records, interests, skills, and career preferences</p>
               </div>
            </div>
            <div class="step-connector"></div>
            <div class="step">
               <div class="step-number">02</div>
               <div class="step-content">
                  <div class="step-icon">
                     <i class="fas fa-microchip"></i>
                  </div>
                  <h3>AI Analysis</h3>
                  <p>Our AI analyzes your profile using advanced algorithms and machine learning</p>
               </div>
            </div>
            <div class="step-connector"></div>
            <div class="step">
               <div class="step-number">03</div>
               <div class="step-content">
                  <div class="step-icon">
                     <i class="fas fa-chart-pie"></i>
                  </div>
                  <h3>Get Recommendations</h3>
                  <p>Receive detailed career, course, scholarship, and skill recommendations</p>
               </div>
            </div>
            <div class="step-connector"></div>
            <div class="step">
               <div class="step-number">04</div>
               <div class="step-content">
                  <div class="step-icon">
                     <i class="fas fa-flag-checkered"></i>
                  </div>
                  <h3>Plan Your Future</h3>
                  <p>Take actionable steps towards your dream career with confidence</p>
               </div>
            </div>
         </div>
      </div>
   </section>

   <!-- Statistics Section -->
   <section class="statistics" aria-label="Statistics section">
      <div class="container">
         <div class="stats-grid">
            <div class="stats-item">
               <div class="stats-icon">
                  <i class="fas fa-users"></i>
               </div>
               <div class="stats-number" data-target="50000">0</div>
               <div class="stats-label">Students Helped</div>
            </div>
            <div class="stats-item">
               <div class="stats-icon">
                  <i class="fas fa-university"></i>
               </div>
               <div class="stats-number" data-target="200">0</div>
               <div class="stats-label">Partner Universities</div>
            </div>
            <div class="stats-item">
               <div class="stats-icon">
                  <i class="fas fa-trophy"></i>
               </div>
               <div class="stats-number" data-target="150">0</div>
               <div class="stats-label">Scholarship Programs</div>
            </div>
            <div class="stats-item">
               <div class="stats-icon">
                  <i class="fas fa-chart-line"></i>
               </div>
               <div class="stats-number" data-target="94">0</div>
               <div class="stats-label">Success Rate (%)</div>
            </div>
         </div>
      </div>
   </section>

   <!-- Call To Action Section -->
   <section class="cta" aria-label="Call to action section">
      <div class="container">
         <div class="cta-content">
            <h2>Ready to Discover Your Future?</h2>
            <p>Join thousands of students who have found their ideal career path with our AI-powered guidance</p>
            <div class="cta-actions">
               <a href="/assessment" class="btn btn-primary btn-large">
                  <i class="fas fa-arrow-right"></i> Start Your Journey
               </a>
               <a href="/pricing" class="btn btn-secondary btn-large">
                  <i class="fas fa-tags"></i> View Pricing
               </a>
            </div>
         </div>
      </div>
   </section>

   <!-- Footer -->
   <footer class="footer" role="contentinfo">
      <div class="footer-container">
         <div class="footer-grid">
            <div class="footer-brand">
               <div class="logo">
                  <i class="fas fa-robot"></i>
                  <span>AI Career<span class="highlight">Predictor</span></span>
               </div>
               <p>Empowering students to make informed career decisions through AI-powered insights and personalized
                  guidance.</p>
               <div class="social-links">
                  <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                  <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                  <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                  <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
               </div>
            </div>
            <div class="footer-links">
               <h4>Platform</h4>
               <ul>
                  <li><a href="/assessment">Assessment</a></li>
                  <li><a href="/results">Results</a></li>
                  <li><a href="/scholarship">Scholarships</a></li>
                  <li><a href="/skills">Skills</a></li>
                  <li><a href="/pricing">Pricing</a></li>
               </ul>
            </div>
            <div class="footer-links">
               <h4>Resources</h4>
               <ul>
                  <li><a href="#">Career Guide</a></li>
                  <li><a href="#">Success Stories</a></li>
                  <li><a href="#">FAQ</a></li>
                  <li><a href="#">Blog</a></li>
               </ul>
            </div>
            <div class="footer-links">
               <h4>Company</h4>
               <ul>
                  <li><a href="#">About Us</a></li>
                  <li><a href="#">Contact</a></li>
                  <li><a href="#">Privacy Policy</a></li>
                  <li><a href="#">Terms of Service</a></li>
               </ul>
            </div>
         </div>
         <div class="footer-bottom">
            <p>&copy; 2026 AI Career Predictor. All rights reserved.</p>
            <p class="footer-tech">Powered by <i class="fas fa-microchip"></i> AI Technology</p>
         </div>
      </div>
   </footer>

   <!-- Scripts -->
   <script src="/script.js"></script>
</body>

</html>