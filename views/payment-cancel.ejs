<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>Payment Cancelled - AI Career Predictor</title>
   <link rel="stylesheet" href="/style.css">
   <link rel="stylesheet" href="/payments.css">
   <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
   <div class="payment-result-page">
      <div class="payment-result-card cancel">
         <div class="result-icon">
            <i class="fas fa-times-circle"></i>
         </div>
         <h1>Payment Cancelled</h1>
         <p class="result-message">
            No charges were made. You can continue with the free plan or try again when you're ready.
         </p>

         <div class="result-actions">
            <a href="/pricing" class="btn btn-primary btn-large">
               <i class="fas fa-tags"></i> View Pricing
            </a>
            <a href="/results" class="btn btn-secondary btn-large">
               <i class="fas fa-arrow-left"></i> Back to Results
            </a>
         </div>
      </div>
   </div>
</body>

</html>
