# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Session (change in production)
SESSION_SECRET=your_random_session_secret_here

# Paystack (Nigeria) — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_a4d31d3967ca2bfb4fb3d843fbba5f8859a84b4e
PAYSTACK_PUBLIC_KEY=pk_test_70e2c61df09a6311147bcffcdb1c27baa099bf86

# Paystack Webhook URL (Dashboard → Settings → Webhooks):
# https://yourdomain.com/api/webhooks/paystack
# Enable events: charge.success, subscription.create, subscription.disable, invoice.payment_failed

# Optional: Paystack Plan codes for auto-renewing subscriptions (Dashboard → Plans)
# Leave blank to charge a one-time amount per period instead
PAYSTACK_PLAN_PRO_MONTHLY=
PAYSTACK_PLAN_PRO_YEARLY=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
